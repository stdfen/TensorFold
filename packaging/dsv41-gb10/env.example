# Copy to one private file per node. Do not commit real addresses or credentials.
TF_MODEL_DIR=/models/model
TF_DSV41_ASSETS=/assets
TF_DSV41_ENGRAM_DIR=/engram
TF_EXPERIMENTAL=deepseek
TF_TP_WORLD=2
TF_TP_RANK=0
TF_TP_MASTER=192.0.2.10
TF_TP_PORT=29500
TF_TP_DEVICE=0
TF_TP_FAILFAST=1
TF_COMM_BACKEND=nccl
TF_HTTP_HOST=0.0.0.0
TF_HTTP_PORT=8080
TF_CONTEXT=32768
TF_PARALLEL=1
TF_MAX_TOKENS=32768
TF_TEMPERATURE=1.0
TF_TOP_P=0.95
TF_TOP_K=20
TF_THINKING=1
# TF_REASONING_EFFORT=high
# TF_THINKING_BUDGET=32768
TF_DSV41_DRAFTS=0
TF_REQUIRE_ASSET_HASHES=1
# TF_CHAT_TEMPLATE=/models/model/chat_template.jinja

# Author-performance settings mapped to TensorFold v1.2.1. Generate AOT with
# the same settings before enabling replay, PF_4K, R1 or drafts; they are not
# part of this first compatible restart.
TF_DSV41_GRAPHS=1
TF_DSV41_GRAPHS_MAX=128
TF_DSV41_GM_V2=1
TF_DSV41_PF_DENSE=fused
TF_DSV41_ENGRAM_AIO=1
TF_DSV41_ENGRAM_PREFETCH=1
TF_DSV41_PREFETCH_AHEAD=1

# Strict hybrid RoCE: exchanges through 20 MiB are split into <=1 MiB RDMA
# writes; larger collectives remain on NCCL by v1.2.1 design. Validate the
# HCA/GID on both nodes instead of copying this example blindly.
TF_COMM_BACKEND=roce
TF_TP_KERNEL_IMAGE=/opt/tensorfold/share/tp_mailbox.fatbin
TF_TP_ROCE_FALLBACK=error
TF_TP_ROCE_HCA=rocep1s0f1:3
TF_TP_MAILBOX_MAX_KB=1024
TF_TP_ROCE_CHUNKED_KB=20480
TF_TP_ROCE_FAST=1
TF_TP_PLAN_LINK=rdma
TF_TP_PLAN_PIN=auto

